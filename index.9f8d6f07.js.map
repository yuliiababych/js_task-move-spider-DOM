"use strict";
document.addEventListener("click", function(e) {
    var wall = document.querySelector(".wall");
    var spider = document.querySelector(".spider");
    var wallRect = wall.getBoundingClientRect();
    if (e.clientX >= wallRect.left && e.clientX <= wallRect.right && e.clientY >= wallRect.top && e.clientY <= wallRect.bottom) {
        e.preventDefault();
        var wallY = wall.clientHeight;
        var wallX = wall.clientWidth;
        var spiderX = spider.clientWidth;
        var spiderY = spider.clientHeight;
        var clickX = e.offsetX;
        var clickY = e.offsetY;
        var maxX = wallX - spiderX;
        var maxY = wallY - spiderY;
        spider.style.left = Math.max(0, Math.min(clickX - spiderX / 2, maxX)) + "px";
        spider.style.top = Math.max(0, Math.min(clickY - spiderY / 2, maxY)) + "px";
    }
});

